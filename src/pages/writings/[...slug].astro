---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import FoodCard from '../../components/FoodCard.astro';
import BookCard from '../../components/BookCard.astro';
import Gallery from '../../components/Gallery.astro';
import {
  categoryLabel,
  categoryLabelZh,
  formatDateLong,
  isChinese,
  langLabel,
  readingTime,
  trackLabel,
} from '../../lib/format';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const showToc = (entry.data.toc || headings.length > 5) && headings.length > 2;
const minutes = readingTime(entry.body ?? '');
const zh = isChinese(entry.data.lang);

const all = (await getCollection('writings')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const index = all.findIndex((w) => w.id === entry.id);
const newer = index > 0 ? all[index - 1] : null;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
  type="article"
  published={entry.data.date}
>
  <div class="shell">
    <article>
      <header class="article-head">
        <p class="kicker">
          {trackLabel(entry.data.track)} — {categoryLabel(entry.data.category)}
        </p>
        <h1 lang={zh ? 'zh' : undefined}>{entry.data.title}</h1>
        {entry.data.subtitle && (
          <p class="lede" lang={zh ? 'zh' : undefined}>{entry.data.subtitle}</p>
        )}
        <p class="small-meta">
          <time datetime={entry.data.date.toISOString()}>{formatDateLong(entry.data.date)}</time>
          <span class="dot"></span>
          {minutes} min read
          <span class="dot"></span>
          <span class="badge">{langLabel(entry.data.lang)}</span>
          {entry.data.category === 'food-reviews' && (
            <>
              <span class="dot"></span>
              <span class="badge">{categoryLabelZh(entry.data.category)}</span>
            </>
          )}
        </p>
      </header>

      <div class:list={['article-layout', { 'has-toc': showToc }]}>
        <div>
          {entry.data.food && <FoodCard food={entry.data.food} />}
          {entry.data.book && <BookCard book={entry.data.book} />}

          <div class:list={['prose', { dropcap: !zh }]} lang={zh ? 'zh' : undefined}>
            <Content />
          </div>

          {entry.data.food && entry.data.food.photos.length > 0 && (
            <section style="margin-top: 2.5rem">
              <div class="section-head" style="margin-bottom: 1rem">
                <h2 style="font-size: 1rem">Photographs</h2>
              </div>
              <Gallery photos={entry.data.food.photos} id="food" />
            </section>
          )}

          {entry.data.tags.length > 0 && (
            <div class="tag-row">
              {entry.data.tags.map((tag) => (
                <a class="tag" href={`/search?q=${encodeURIComponent(tag)}`}>#{tag}</a>
              ))}
            </div>
          )}

          <div class="post-foot">
            <a href="/writings">← All writings</a>
            <span>
              {entry.data.track === 'professional' ? 'Professional' : 'Personal'} ·{' '}
              {categoryLabel(entry.data.category)}
            </span>
          </div>

          <nav
            aria-label="More writings"
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 2rem"
            class="post-nav"
          >
            {older && (
              <a href={`/writings/${older.id}`} style="text-decoration: none">
                <span class="kicker kicker--muted" style="display: block">Previous</span>
                <span style="font-family: var(--serif); font-size: 1rem">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a
                href={`/writings/${newer.id}`}
                style="text-decoration: none; text-align: right"
              >
                <span class="kicker kicker--muted" style="display: block">Next</span>
                <span style="font-family: var(--serif); font-size: 1rem">{newer.data.title}</span>
              </a>
            )}
          </nav>

          {entry.data.comments && <Comments />}
        </div>

        {showToc && (
          <div class="toc-col">
            <Toc headings={headings} />
          </div>
        )}
      </div>
    </article>
  </div>
</Base>

<style>
  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr !important;
    }
    .post-nav a:last-child {
      text-align: left !important;
    }
  }
</style>
