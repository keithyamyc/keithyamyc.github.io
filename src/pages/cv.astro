---
import Base from '../layouts/Base.astro';
import { SITE, CV_DATA } from '../config/site';
import { getCollection } from 'astro:content';

const writings = await getCollection('writings');
const music = await getCollection('music');
const rolls = await getCollection('film');

const counts = {
  writings: writings.length,
  music: music.length,
  rolls: rolls.length,
};
---

<Base
  title="About & CV"
  description="About Keith Yam — legal practitioner and writer. Background, professional experience, education, and a downloadable CV."
>
  <div class="shell">
    <header class="page-head">
      <p class="kicker">About &amp; CV</p>
      <h1>Keith Yam</h1>
      <p>
        Legal practitioner, essayist, and occasional photographer. I write about public
        law and civic institutions, keep a notebook of the personal, and spend far too
        much of the year listening to symphonies.
      </p>
    </header>

    <div class="cv-grid">
      <aside class="cv-aside">
        <section>
          <h4>Contact</h4>
          <ul>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            {SITE.social.linkedin && (
              <li><a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
            )}
            {SITE.social.github && (
              <li><a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a></li>
            )}
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </section>

        <section>
          <h4>Languages</h4>
          <ul>
            {CV_DATA.languages.map((lang) => (
              <li>
                <strong style="color: var(--ink)">{lang.name}</strong><br />
                <span style="color: var(--muted); font-size: 0.92em">{lang.proficiency}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="cv-webonly">
          <h4>On this site</h4>
          <ul>
            <li>{counts.writings} writings</li>
            <li>{counts.music} music entries</li>
            <li>{counts.rolls} film rolls</li>
          </ul>
        </section>

        <div class="cv-actions">
          <a class="btn" href="/keith-yam-cv.pdf" download>Download PDF</a>
          <button class="btn btn--ghost" type="button" data-print>Print</button>
        </div>
      </aside>

      <div>
        <section class="cv-section">
          <h2>Profile</h2>
          <p class="lede" style="margin-bottom: 0; font-size: 1.05rem">{CV_DATA.summary}</p>
        </section>

        <section class="cv-section">
          <h2>Experience</h2>
          {CV_DATA.experience.map((job) => (
            <div class="cv-item">
              <div class="cv-item__period">{job.period}</div>
              <div class="cv-item__body">
                <h3>{job.role}</h3>
                <p class="cv-item__org">{job.organization} · {job.location}</p>
                <ul>
                  {job.highlights.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </section>

        <section class="cv-section">
          <h2>Education</h2>
          {CV_DATA.education.map((item) => (
            <div class="cv-item">
              <div class="cv-item__period">{item.period}</div>
              <div class="cv-item__body">
                <h3>{item.degree}</h3>
                <p class="cv-item__org">{item.institution}</p>
                <p style="font-size: 0.9rem; color: var(--muted); margin: 0">{item.details}</p>
              </div>
            </div>
          ))}
        </section>

        <section class="cv-section">
          <h2>Writing &amp; Interests</h2>
          {CV_DATA.writingAndInterests.map((item) => (
            <div class="cv-item">
              <div class="cv-item__period"></div>
              <div class="cv-item__body">
                <h3>{item.title}</h3>
                <p style="font-size: 0.92rem; color: var(--ink-soft); margin: 0.3rem 0 0">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </section>

        <section class="cv-section">
          <h2>Selected on this site</h2>
          <ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem">
            <li><a href="/writings">Writings — professional and personal</a></li>
            <li><a href="/music">Music — concert notes, recordings, essays</a></li>
            <li><a href="/film">Film &amp; Travel — rolls and photographs</a></li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
    window.print();
  });
</script>
