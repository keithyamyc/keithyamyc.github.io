---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { formatDate } from '../../lib/format';

const rolls = (await getCollection('film')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const frames = rolls.reduce((sum, roll) => sum + roll.data.photos.length, 0);
---

<Base
  title="Film & Travel"
  description="Film photography from travels — organised by roll, with camera, lens and film stock notes."
>
  <div class="shell">
    <header class="page-head">
      <p class="kicker">Film &amp; Travel</p>
      <h1>Rolls, not albums</h1>
      <p>
        I take a film camera with me three or four times a year and come home with
        fewer usable frames than I expect. Each page is one roll: the place, the light,
        the camera, and the stock.
      </p>
      <p class="small-meta" style="margin-top: 1.1rem">
        {rolls.length} {rolls.length === 1 ? 'roll' : 'rolls'}
        <span class="dot"></span>
        {frames} selected frames
      </p>
    </header>

    {rolls.length === 0 && (
      <p class="empty">
        No rolls published yet. Photographs will appear here once the first roll is added.
      </p>
    )}

    <div class="card-grid">
      {rolls.map((roll) => (
        <Card
          href={`/film/${roll.id}`}
          image={roll.data.coverPhoto}
          sample={roll.data.sample}
          imageAlt={roll.data.title}
          kicker={`${roll.data.rollNumber} · ${roll.data.season}`}
          title={roll.data.title}
          excerpt={roll.data.excerpt}
          footLeft={roll.data.filmStock}
          footRight={formatDate(roll.data.date)}
        />
      ))}
    </div>
  </div>
</Base>
