---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Comments from '../../components/Comments.astro';
import { formatDateLong } from '../../lib/format';

export async function getStaticPaths() {
  const rolls = await getCollection('film');
  return rolls.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const isPhotoEssay = entry.data.layout === 'photo';
const hasIntro = Boolean((entry.body ?? '').trim());

const all = (await getCollection('film')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const index = all.findIndex((r) => r.id === entry.id);
const newer = index > 0 ? all[index - 1] : null;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
  type="article"
  image={entry.data.coverPhoto}
  published={entry.data.date}
>
  <div class="shell">
    <article>
      <header class="article-head">
        <p class="kicker">{entry.data.rollNumber} · {entry.data.season} · {entry.data.location}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.excerpt}</p>
        <p class="small-meta">
          {entry.data.updated ? (
            <>
              <span>Published <time datetime={entry.data.date.toISOString()}>{formatDateLong(entry.data.date)}</time></span>
              <span class="dot"></span>
              <span>Updated <time datetime={entry.data.updated.toISOString()}>{formatDateLong(entry.data.updated)}</time></span>
            </>
          ) : (
            <time datetime={entry.data.date.toISOString()}>{formatDateLong(entry.data.date)}</time>
          )}
          <span class="dot"></span>
          {entry.data.photos.length} frames
        </p>
      </header>

      {
        isPhotoEssay ? (
          <>
            {hasIntro && (
              <div class="photo-intro prose">
                <Content />
              </div>
            )}

            <p class="roll-strip">
              <span>{entry.data.camera}</span>
              {entry.data.lens && <span>{entry.data.lens}</span>}
              <span>{entry.data.filmStock}</span>
              <span>{entry.data.location}</span>
            </p>

            <Gallery photos={entry.data.photos} id={entry.id} layout="stack" />
          </>
        ) : (
          <div class="split-photos">
            <div class="prose" style="max-width: none">
              <Content />
            </div>

            <aside class="split-photos__aside">
              <div class="roll-spec">
                <div class="meta-card__head">
                  <span>Roll Record</span>
                  <span>{entry.data.rollNumber}</span>
                </div>
                <dl>
                  <div>
                    <dt>Camera</dt>
                    <dd>{entry.data.camera}</dd>
                  </div>
                  {entry.data.lens && (
                    <div>
                      <dt>Lens</dt>
                      <dd>{entry.data.lens}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Film</dt>
                    <dd>{entry.data.filmStock}</dd>
                  </div>
                  <div>
                    <dt>Location</dt>
                    <dd>{entry.data.location}</dd>
                  </div>
                  <div>
                    <dt>Season</dt>
                    <dd>{entry.data.season}</dd>
                  </div>
                  <div>
                    <dt>Developed</dt>
                    <dd>{formatDateLong(entry.data.date)}</dd>
                  </div>
                </dl>
              </div>

              <Gallery photos={entry.data.photos} id={entry.id} layout="rail" />
            </aside>
          </div>
        )
      }

      <div class="post-foot">
        <a href="/film">← All rolls</a>
        <span>{entry.data.photos.length} frames · {entry.data.filmStock}</span>
      </div>

      <nav
        aria-label="More rolls"
        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 2rem"
        class="post-nav"
      >
        {older && (
          <a href={`/film/${older.id}`} style="text-decoration: none">
            <span class="kicker kicker--muted" style="display: block">Previous roll</span>
            <span style="font-family: var(--serif); font-size: 1rem">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a href={`/film/${newer.id}`} style="text-decoration: none; text-align: right">
            <span class="kicker kicker--muted" style="display: block">Next roll</span>
            <span style="font-family: var(--serif); font-size: 1rem">{newer.data.title}</span>
          </a>
        )}
      </nav>

      {entry.data.comments && <Comments />}
    </article>
  </div>
</Base>

<style>
  .roll-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.1rem;
    margin: 1.6rem 0 0;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }

  .roll-strip span + span::before {
    content: '·';
    margin-right: 1.1rem;
    color: var(--rule-strong);
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr !important;
    }
    .post-nav a:last-child {
      text-align: left !important;
    }
    .roll-strip span + span::before {
      content: none;
      margin-right: 0;
    }
  }
</style>
