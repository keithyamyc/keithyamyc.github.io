---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <div class="shell narrow">
    <div style="padding-block: clamp(3rem, 10vw, 7rem)">
      <p class="kicker">Error 404</p>
      <h1 style="margin-bottom: 0.8rem">This page is missing.</h1>
      <p class="lede" style="margin-bottom: 1.8rem">
        Either it has moved, or it never existed, or the link was typed from memory on a
        train. All three are plausible.
      </p>
      <div class="cv-actions">
        <a class="btn" href="/">Back to the front page</a>
        <a class="btn btn--ghost" href="/search">Search the site</a>
      </div>
    </div>
  </div>
</Base>
