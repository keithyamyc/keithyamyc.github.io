---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import ProgrammeCard from '../../components/ProgrammeCard.astro';
import RecordingCard from '../../components/RecordingCard.astro';
import { formatDateLong, isChinese, langLabel, musicTypeLabel, slugify } from '../../lib/format';

export async function getStaticPaths() {
  const music = await getCollection('music');
  return music.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const showToc = (entry.data.toc || headings.length > 5) && headings.length > 2;
const zh = isChinese(entry.data.lang);

const all = (await getCollection('music')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const index = all.findIndex((m) => m.id === entry.id);
const newer = index > 0 ? all[index - 1] : null;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
  type="article"
  published={entry.data.date}
>
  <div class="shell">
    <article>
      <header class="article-head">
        <p class="kicker">{musicTypeLabel(entry.data.type)}</p>
        <h1 lang={zh ? 'zh' : undefined}>{entry.data.title}</h1>
        {entry.data.subtitle && (
          <p class="lede" lang={zh ? 'zh' : undefined}>{entry.data.subtitle}</p>
        )}
        <p class="small-meta">
          {entry.data.updated ? (
            <>
              <span>Published <time datetime={entry.data.date.toISOString()}>{formatDateLong(entry.data.date)}</time></span>
              <span class="dot"></span>
              <span>Updated <time datetime={entry.data.updated.toISOString()}>{formatDateLong(entry.data.updated)}</time></span>
            </>
          ) : (
            <time datetime={entry.data.date.toISOString()}>{formatDateLong(entry.data.date)}</time>
          )}
          <span class="dot"></span>
          <span class="badge">{langLabel(entry.data.lang)}</span>
          {entry.data.sample && <span class="badge badge--accent">Sample</span>}
        </p>
      </header>

      <div class:list={['article-layout', { 'has-toc': showToc }]}>
        <div>
          {entry.data.concert && <ProgrammeCard concert={entry.data.concert} />}
          {entry.data.recording && <RecordingCard recording={entry.data.recording} />}

          <div class:list={['prose', { dropcap: !zh }]} lang={zh ? 'zh' : undefined}>
            <Content />
          </div>

          {(entry.data.composers.length > 0 || entry.data.performers.length > 0) && (
            <div style="margin-top: 2.2rem">
              {entry.data.composers.length > 0 && (
                <>
                  <p class="kicker kicker--muted" style="margin-bottom: 0.5rem">Composers</p>
                  <div class="chips" style="margin-top: 0">
                    {entry.data.composers.map((composer) => (
                      <a class="chip" href={`/music/composer/${slugify(composer)}`}>{composer}</a>
                    ))}
                  </div>
                </>
              )}
              {entry.data.performers.length > 0 && (
                <>
                  <p class="kicker kicker--muted" style="margin: 1.4rem 0 0.5rem">Performers</p>
                  <div class="chips" style="margin-top: 0">
                    {entry.data.performers.map((performer) => (
                      <a class="chip" href={`/music/performer/${slugify(performer)}`}>{performer}</a>
                    ))}
                  </div>
                </>
              )}
            </div>
          )}

          <div class="post-foot">
            <a href="/music">← All music</a>
            <span>{musicTypeLabel(entry.data.type)}</span>
          </div>

          <nav
            aria-label="More music"
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 2rem"
            class="post-nav"
          >
            {older && (
              <a href={`/music/${older.id}`} style="text-decoration: none">
                <span class="kicker kicker--muted" style="display: block">Previous</span>
                <span style="font-family: var(--serif); font-size: 1rem">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a href={`/music/${newer.id}`} style="text-decoration: none; text-align: right">
                <span class="kicker kicker--muted" style="display: block">Next</span>
                <span style="font-family: var(--serif); font-size: 1rem">{newer.data.title}</span>
              </a>
            )}
          </nav>

          {entry.data.comments && <Comments />}
        </div>

        {showToc && (
          <div class="toc-col">
            <Toc headings={headings} />
          </div>
        )}
      </div>
    </article>
  </div>
</Base>

<style>
  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr !important;
    }
    .post-nav a:last-child {
      text-align: left !important;
    }
  }
</style>
