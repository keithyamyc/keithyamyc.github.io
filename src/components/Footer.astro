---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <h4>{SITE.title}</h4>
        <p style="font-size: 0.9rem; color: var(--muted); max-width: 34ch; margin: 0;">
          {SITE.description}
        </p>
      </div>

      <div>
        <h4>Sections</h4>
        <ul>
          <li><a href="/writings">Writings</a></li>
          <li><a href="/music">Music</a></li>
          <li><a href="/film">Film &amp; Travel</a></li>
          <li><a href="/cv">About &amp; CV</a></li>
        </ul>
      </div>

      <div>
        <h4>Elsewhere</h4>
        <ul>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="/search">Search</a></li>
          <li><a href={`mailto:${SITE.email}`}>Email</a></li>
          {SITE.social.github && (
            <li><a href={SITE.social.github} rel="me noopener" target="_blank">GitHub</a></li>
          )}
          {SITE.social.instagram && (
            <li><a href={SITE.social.instagram} rel="me noopener" target="_blank">Instagram</a></li>
          )}
        </ul>
      </div>
    </div>

    <div class="footer-note">
      <span>© {year} {SITE.title}. All writings &amp; photographs.</span>
      <span>Set in Newsreader &amp; Noto Serif CJK</span>
    </div>
  </div>
</footer>
