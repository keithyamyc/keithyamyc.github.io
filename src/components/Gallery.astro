---
interface Photo {
  src: string;
  title?: string;
  caption: string;
  location?: string;
  frame?: string;
  aspect?: 'landscape' | 'portrait' | 'square';
}

interface Props {
  photos: Photo[];
  id?: string;
  layout?: 'grid' | 'rail';
}
const { photos, id = 'gallery', layout = 'grid' } = Astro.props;
---

{
  layout === 'rail' ? (
    <div class="photo-rail" data-gallery={id}>
      {photos.map((photo, i) => (
        <figure class="rail-item">
          <button
            type="button"
            data-lightbox-index={i}
            data-full={photo.src}
            data-caption={photo.caption}
            data-title={photo.frame ?? photo.title ?? ''}
            aria-label={`Open photograph: ${photo.caption}`}
          >
            <img
              src={photo.src}
              alt={photo.caption}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
          {photo.caption && (
            <figcaption>
              {photo.frame && <span style="font-family: var(--mono); font-size: 0.9em">{photo.frame} · </span>}
              {photo.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  ) : (
    <div class="gallery" data-gallery={id}>
      {photos.map((photo, i) => (
        <button
          class:list={[
            'gallery__item',
            photo.aspect === 'portrait' && 'gallery__item--tall',
            photo.aspect === 'square' && 'gallery__item--square',
          ]}
          type="button"
          data-lightbox-index={i}
          data-full={photo.src}
          data-caption={photo.caption}
          data-title={photo.frame ?? photo.title ?? ''}
          aria-label={`Open photograph: ${photo.caption}`}
        >
          <img
            src={photo.src}
            alt={photo.caption}
            loading={i < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </button>
      ))}
    </div>
  )
}
