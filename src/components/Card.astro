---
interface Props {
  href: string;
  image?: string;
  imageAlt?: string;
  kicker?: string;
  title: string;
  excerpt?: string;
  footLeft?: string;
  footRight?: string;
  sample?: boolean;
}

const { href, image, imageAlt = '', kicker, title, excerpt, footLeft, footRight, sample = false } = Astro.props;
---

<a class="card" href={href}>
  {image && (
    <div class="card__media">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card__body">
    {sample && <span class="badge" style="align-self: flex-start">Sample</span>}
    {kicker && <span class="kicker" style="margin-bottom: 0">{kicker}</span>}
    <h3>{title}</h3>
    {excerpt && <p>{excerpt}</p>}
    {(footLeft || footRight) && (
      <div class="card__foot">
        <span>{footLeft}</span>
        <span>{footRight}</span>
      </div>
    )}
  </div>
</a>
